<package format="3">
  <name>camera_launch</name>
  <version>0.1.0</version>
  <description>Launch and config wrapper for v4l2_camera on Jetson Orin Nano</description>
  <maintainer email="dev@example.com">slam_project</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>camera_info_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
