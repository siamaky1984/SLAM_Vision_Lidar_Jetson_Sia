<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- MIT License – see LICENSE in repo root -->
<package format="3">
  <name>slam_bringup</name>
  <version>0.1.0</version>
  <description>Top-level bringup: orchestrates camera, lidar, ORB-SLAM3, RTAB-Map, and TF launches</description>
  <maintainer email="dev@example.com">slam_project</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>camera_launch</exec_depend>
  <exec_depend>rplidar_launch</exec_depend>
  <exec_depend>orb_slam3_wrapper</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>
  <exec_depend>tf_broadcasters</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
